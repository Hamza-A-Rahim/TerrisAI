{
  "name": "terris-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/stage-data.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run cf-types && tsc --noEmit && tsc --noEmit -p worker",
    "cf-types": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "geotiff": "^2.1.3",
    "maplibre-gl": "^5.6.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.153.0"
  }
}
