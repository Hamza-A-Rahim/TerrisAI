# No keys are required for local development.
# Every data source used today (Planetary Computer STAC, Natural Earth, Nominatim,
# Photon, EOX and OpenFreeMap tiles) is public and keyless.
#
# Planned (not used yet). Copy to .env and fill in locally. Never commit .env.

# Cloudflare R2: object storage for the Cloud-Optimized GeoTIFFs and overlays in production
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# NEXT_PUBLIC_DATA_BASE_URL=https://<your-r2-public-domain>

# Optional: Planetary Computer subscription key for higher rate limits
# PC_SDK_SUBSCRIPTION_KEY=
